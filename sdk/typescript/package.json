{
  "name": "@kurama/sdk",
  "version": "0.2.0",
  "description": "Typed, headless Kurama agents using your installed Kurama binary",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/saarthak314/kurama/blob/main/docs/sdk.md",
  "repository": { "type": "git", "url": "git+https://github.com/saarthak314/kurama.git", "directory": "sdk/typescript" },
  "type": "module",
  "engines": { "node": ">=22" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist", "src", "examples"],
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
